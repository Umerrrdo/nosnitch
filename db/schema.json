{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Umerrrdo/phonehome/blob/main/db/schema.json",
  "title": "phonehome app entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "images", "telemetry_default", "disable", "sources", "verified_on", "verified"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "images": {
      "description": "Image names without tag or digest. Docker Hub images are written without a registry (n8nio/n8n). A * matches any run of characters.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9*][a-z0-9._*/:-]*$" }
    },
    "telemetry_default": { "enum": ["on", "off", "partial", "unknown"] },
    "destinations": {
      "description": "Hostnames the telemetry is sent to. Only documented ones.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" }
    },
    "what_is_sent": { "type": "string", "minLength": 1 },
    "still_sent": {
      "description": "What keeps going out even after the documented opt-out is applied.",
      "type": "string",
      "minLength": 1
    },
    "disable": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/env" },
          { "$ref": "#/definitions/flag" },
          { "$ref": "#/definitions/config_file" },
          { "$ref": "#/definitions/manual" }
        ]
      }
    },
    "fixed_in": {
      "description": "Version where the default became off.",
      "type": "string",
      "pattern": "^v?\\d+(\\.\\d+){0,2}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://\\S+$" }
    },
    "verified_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verified": { "type": "boolean" },
    "notes": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "envPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "value": { "type": "string" },
        "accepted_values": {
          "description": "Other values that also count as disabled.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "value"],
      "properties": {
        "type": { "const": "env" },
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "value": { "type": "string" },
        "accepted_values": { "type": "array", "items": { "type": "string" } },
        "alternatives": {
          "description": "Other variables that achieve the same thing.",
          "type": "array",
          "items": { "$ref": "#/definitions/envPair" }
        },
        "optional": {
          "description": "True when this stops other outbound calls (update checks and so on) rather than telemetry itself.",
          "type": "boolean"
        },
        "note": { "type": "string" }
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "flag"],
      "properties": {
        "type": { "const": "flag" },
        "flag": { "type": "string", "pattern": "^-" },
        "note": { "type": "string" }
      }
    },
    "config_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "key", "value"],
      "properties": {
        "type": { "const": "config_file" },
        "path": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instructions"],
      "properties": {
        "type": { "const": "manual" },
        "instructions": { "type": "string", "minLength": 1 }
      }
    }
  }
}
